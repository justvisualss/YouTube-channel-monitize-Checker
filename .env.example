# ==============================================================================
# ChannelScope Analytics - Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MANDATORY FOR LIVE PUBLIC CHANNEL ANALYTICS
# ------------------------------------------------------------------------------
# YOUTUBE_API_KEY: Official Google Cloud API key with YouTube Data API v3 enabled.
# Security: Stored strictly on the server; NEVER prefixed with VITE_ or exposed to the client.
YOUTUBE_API_KEY=""

# APP_URL: The public base URL where this application is hosted.
# Used for canonical SEO URLs, sitemaps, and OAuth callback redirection.
APP_URL="https://channelscope.app"

# PORT: Server listening port (defaults to 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 2. OPTIONAL FOR AUTHORIZED CHANNEL OWNER ANALYTICS
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client credentials for channel owners accessing private
# YouTube Analytics API reports (daily subscribers gained/lost, monetary reports, geo audience).
# If omitted, public analytics and demo mode continue to operate without interruption.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="https://channelscope.app/api/oauth/callback"

# TOKEN_ENCRYPTION_KEY: Secret key for encrypting stored session credentials.
TOKEN_ENCRYPTION_KEY=""

# ------------------------------------------------------------------------------
# 3. OPTIONAL CONTACT / MAIL SERVICE
# ------------------------------------------------------------------------------
# If omitted, the contact form records requests without claiming false delivery.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""
